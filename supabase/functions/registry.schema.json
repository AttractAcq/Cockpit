{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attractacq.invalid/schemas/edge-function-registry.schema.json",
  "title": "Attract Acquisition Edge Function Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authority",
    "expectedCounts",
    "profiles",
    "exceptions",
    "functions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "evidenceDate",
        "sourceAudits",
        "maintainerGuide"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidenceDate": {
          "type": "string",
          "format": "date"
        },
        "sourceAudits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maintainerGuide": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expectedCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localFunctions",
        "uiCalled",
        "nonUiCalled",
        "retired"
      ],
      "properties": {
        "localFunctions": {
          "type": "integer",
          "minimum": 1
        },
        "uiCalled": {
          "type": "integer",
          "minimum": 0
        },
        "nonUiCalled": {
          "type": "integer",
          "minimum": 0
        },
        "retired": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/function"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "caller",
        "allowedMethods",
        "authMode",
        "allowedStaffRoles",
        "clientScope",
        "jwtVerification",
        "alternateSecret",
        "serviceRoleUsage",
        "deployable",
        "operationalOwner",
        "requiredEnvironment"
      ],
      "properties": {
        "lifecycle": {
          "enum": [
            "active",
            "internal",
            "background",
            "held",
            "retired"
          ]
        },
        "caller": {
          "enum": [
            "ui",
            "internal_function",
            "cron",
            "webhook",
            "operator",
            "none"
          ]
        },
        "allowedMethods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS"
            ]
          }
        },
        "authMode": {
          "type": "string",
          "minLength": 1
        },
        "allowedStaffRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "clientScope": {
          "enum": [
            "required",
            "derived",
            "not_applicable"
          ]
        },
        "jwtVerification": {
          "enum": [
            "verified",
            "disabled_with_alternate_auth",
            "not_deployable"
          ]
        },
        "alternateSecret": {
          "type": [
            "string",
            "null"
          ]
        },
        "serviceRoleUsage": {
          "type": "boolean"
        },
        "deployable": {
          "type": "boolean"
        },
        "operationalOwner": {
          "type": "string",
          "minLength": 1
        },
        "requiredEnvironment": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "function",
        "check",
        "owner",
        "reason",
        "reviewBy",
        "remediationIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "function": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "check": {
          "enum": [
            "jwt_config_mismatch"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 20
        },
        "reviewBy": {
          "type": "string",
          "format": "date"
        },
        "remediationIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^EF-[A-Z0-9-]+$"
          }
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "system",
        "page",
        "profile",
        "databaseDomains",
        "storageBuckets",
        "externalProviders",
        "requiredEnvironment",
        "auditPhases",
        "remediationIds",
        "testCoverage",
        "internalCallers"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 20
        },
        "system": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "databaseDomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "storageBuckets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "externalProviders": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredEnvironment": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "auditPhases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "remediationIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EF-[A-Z0-9-]+$"
          }
        },
        "testCoverage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "internalCallers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    }
  }
}
